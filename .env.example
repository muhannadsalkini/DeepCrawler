# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Authentication (VULN-002 fix)
# Required. Generate a strong random key, e.g.:  openssl rand -hex 32
# All API requests must include:  x-api-key: <value>
# The /health endpoint is exempt from authentication.
# If this is not set, the API will return 503 for ALL requests (fail-closed).
API_KEY=change-me-to-a-strong-random-secret

# Crawler Defaults
DEFAULT_MAX_DEPTH=3
DEFAULT_MAX_PAGES=100
DEFAULT_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_CONCURRENT=2
RATE_LIMIT_MIN_TIME=100

# MAX_JOBS: hard cap on total jobs held in memory (active + completed + failed).
#   createJob() returns 429 when this limit is reached.
MAX_JOBS=200
# MAX_CONCURRENT_JOBS: hard cap on simultaneously pending/running jobs.
#   createJob() returns 429 when this limit is reached.
MAX_CONCURRENT_JOBS=5
# JOB_TTL_MS: completed/failed jobs older than this are evicted by the cleanup timer (ms).
JOB_TTL_MS=3600000
# JOB_CLEANUP_INTERVAL_MS: how often the background cleanup timer runs (ms).
JOB_CLEANUP_INTERVAL_MS=300000

# Safety & Politeness
MAX_RESPONSE_SIZE=10485760
DEFAULT_TIMEOUT=10000
USER_AGENT=DeepCrawler/1.0 (+https://github.com/deepcrawler)
MIN_REQUEST_TIME=1000
RESPECT_ROBOTS_TXT=true

# Logging
LOG_LEVEL=info
